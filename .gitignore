# Session state — regenerated by Obsidian each run
.obsidian/workspace.json

# Plugin secrets (apiKey + TLS private key)
.obsidian/plugins/obsidian-local-rest-api/data.json

# Trash
.trash/

# Agent tooling (local only — 10 CLAUDE/ is the tracked twin of .claude/)
.claude/
.agents/
# .pi/ is tracked: it ships with the sample vault (settings, extensions, prompts)
